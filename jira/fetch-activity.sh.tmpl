#!/bin/bash
#
# Fetch recent Jira activity for the current user, grouped by ticket.
# Usage: ./fetch-activity.sh [timeframe]
#   timeframe: 24h (default), 4h, 2h, 1d, 2d
#
# Requires: JIRA_API_TOKEN in environment, curl, jq.

set -euo pipefail

JIRA_DOMAIN="__JIRA_DOMAIN__"
JIRA_EMAIL="__JIRA_EMAIL__"
TIMEFRAME="${1:-24h}"

if [[ "$TIMEFRAME" =~ ^([0-9]+)h$ ]]; then
  JQL_TIME="-${BASH_REMATCH[1]}h"; LABEL="${BASH_REMATCH[1]}h"
elif [[ "$TIMEFRAME" =~ ^([0-9]+)d$ ]]; then
  JQL_TIME="-${BASH_REMATCH[1]}d"; LABEL="${BASH_REMATCH[1]}d"
else
  JQL_TIME="-24h"; LABEL="24h"
fi

if [ -z "${JIRA_API_TOKEN:-}" ]; then
  echo "ERROR: JIRA_API_TOKEN not set" >&2; exit 1
fi

AUTH=$(printf '%s' "${JIRA_EMAIL}:${JIRA_API_TOKEN}" | base64)

jira_get() {
  curl -s -H "Authorization: Basic ${AUTH}" -H "Accept: application/json" "$@"
}

search() {
  local jql="$1" fields="${2:-summary,status,updated}"
  jira_get -G \
    --data-urlencode "jql=${jql}" \
    --data-urlencode "maxResults=50" \
    --data-urlencode "fields=${fields}" \
    "https://${JIRA_DOMAIN}/rest/api/3/search/jql"
}

has_jql_error() {
  echo "$1" | jq -e '((.errorMessages // []) | length > 0) or ((.warningMessages // []) | length > 0)' \
    >/dev/null 2>&1
}

MY_ID=$(jira_get "https://${JIRA_DOMAIN}/rest/api/3/myself" | jq -r '.accountId')
if [ -z "$MY_ID" ] || [ "$MY_ID" = "null" ]; then
  echo "ERROR: could not get current user account ID — check JIRA_API_TOKEN" >&2; exit 1
fi

# ── Temp workspace (bash 3.2 compatible; no associative arrays) ───────────────

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
touch "$WORK/order"

add_ticket() {
  local key="$1" summary="$2" status_name="${3:-}" updated="${4:-}"
  local dir="$WORK/$key"
  if [ ! -d "$dir" ]; then
    mkdir "$dir"
    echo "$key" >> "$WORK/order"
    printf '%s' "$summary" > "$dir/summary"
  fi
  if [ -n "$status_name" ] && [ ! -f "$dir/status"  ]; then printf '%s' "$status_name" > "$dir/status";  fi
  if [ -n "$updated"     ] && [ ! -f "$dir/updated" ]; then printf '%s' "$updated"     > "$dir/updated"; fi
}

get_changelog() {
  local key="$1" dir="$WORK/$key"
  if [ ! -f "$dir/changelog" ]; then
    jira_get "https://${JIRA_DOMAIN}/rest/api/3/issue/${key}/changelog?maxResults=100" \
      2>/dev/null > "$dir/changelog" || echo '{"values":[]}' > "$dir/changelog"
  fi
  cat "$dir/changelog"
}

my_field_changes() {
  local cl="$1" field="$2"
  echo "$cl" | jq -r --arg me "$MY_ID" --arg f "$field" '
    [ .values[]
      | select(.author.accountId == $me)
      | select(any(.items[]; .field == $f))
      | { created: .created, item: (.items[] | select(.field == $f)) }
    ]
    | sort_by(.created)[]
    | "\(.created[0:16]) | \(.item.fromString // "Unassigned") → \(.item.toString // "Unassigned")"
  ' 2>/dev/null || true
}

# ── Collect tickets ───────────────────────────────────────────────────────────

# Query 1: assignee changes I made
RESP=$(search "assignee changed by currentUser() AFTER \"${JQL_TIME}\" ORDER BY updated DESC" \
              2>/dev/null || echo '{"issues":[]}')
has_jql_error "$RESP" && RESP=$(search \
  "assignee was currentUser() AND assignee != currentUser() AND updated >= \"${JQL_TIME}\" ORDER BY updated DESC" \
  2>/dev/null || echo '{"issues":[]}')

while IFS=$'\t' read -r key summary status_name updated; do
  [ -z "$key" ] && continue
  add_ticket "$key" "$summary" "$status_name" "$updated"
done < <(echo "$RESP" | jq -r \
  '.issues[] | [.key, (.fields.summary | .[0:55] | gsub("[|\n]";" ")), .fields.status.name, .fields.updated[0:16]] | @tsv' \
  2>/dev/null || true)

# Query 2: status changes I made
RESP=$(search "status changed by currentUser() AFTER \"${JQL_TIME}\" ORDER BY updated DESC" \
              2>/dev/null || echo '{"issues":[]}')
has_jql_error "$RESP" && RESP='{"issues":[]}'

while IFS=$'\t' read -r key summary status_name updated; do
  [ -z "$key" ] && continue
  add_ticket "$key" "$summary" "$status_name" "$updated"
done < <(echo "$RESP" | jq -r \
  '.issues[] | [.key, (.fields.summary | .[0:55] | gsub("[|\n]";" ")), .fields.status.name, .fields.updated[0:16]] | @tsv' \
  2>/dev/null || true)

# Query 3: assigned to me
RESP=$(search "assignee changed to currentUser() AFTER \"${JQL_TIME}\" ORDER BY updated DESC" \
              "summary,status,updated" 2>/dev/null || echo '{"issues":[]}')
has_jql_error "$RESP" && RESP=$(search \
  "assignee = currentUser() AND updated >= \"${JQL_TIME}\" ORDER BY updated DESC" \
  "summary,status,updated" 2>/dev/null || echo '{"issues":[]}')

while IFS=$'\t' read -r key summary status_name updated; do
  [ -z "$key" ] && continue
  add_ticket "$key" "$summary" "$status_name" "$updated"
  touch "$WORK/$key/assigned_to_me"
done < <(echo "$RESP" | jq -r \
  '.issues[] | [.key, (.fields.summary | .[0:55] | gsub("[|\n]";" ")), .fields.status.name, .fields.updated[0:16]] | @tsv' \
  2>/dev/null || true)

# Query 4: issues I created
RESP=$(search "reporter = currentUser() AND created >= \"${JQL_TIME}\" ORDER BY created DESC" \
              "summary,status,created" 2>/dev/null || echo '{"issues":[]}')

while IFS=$'\t' read -r key summary status_name created; do
  [ -z "$key" ] && continue
  add_ticket "$key" "$summary" "$status_name" ""
  touch "$WORK/$key/created_by_me"
  printf '%s' "$created" > "$WORK/$key/created"
done < <(echo "$RESP" | jq -r \
  '.issues[] | [.key, (.fields.summary | .[0:55] | gsub("[|\n]";" ")), .fields.status.name, .fields.created[0:16]] | @tsv' \
  2>/dev/null || true)

# ── Output ────────────────────────────────────────────────────────────────────

echo "## Jira Activity — Last ${LABEL}"
echo ""

if [ ! -s "$WORK/order" ]; then
  echo "_No activity found._"
  exit 0
fi

while IFS= read -r key; do
  [ -z "$key" ] && continue
  dir="$WORK/$key"
  URL="https://${JIRA_DOMAIN}/browse/${key}"
  summary=$(cat "$dir/summary")
  echo "### [${key}](${URL}) — ${summary}"
  echo ""

  # Merge assignee + status changelog events, sort chronologically
  CL=$(get_changelog "$key")
  EVENTS=""
  while IFS= read -r row; do
    [ -z "$row" ] && continue
    EVENTS="${EVENTS}${row} | Assignee"$'\n'
  done < <(my_field_changes "$CL" "assignee")
  while IFS= read -r row; do
    [ -z "$row" ] && continue
    EVENTS="${EVENTS}${row} | Status"$'\n'
  done < <(my_field_changes "$CL" "status")

  if [ -n "$EVENTS" ]; then
    echo "| Time | Change | Type |"
    echo "| ---- | ------ | ---- |"
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      echo "| ${line} |"
    done < <(printf '%s' "$EVENTS" | sort)
    echo ""
  fi

  # Metadata line for assignment/creation state
  META=""
  if [ -f "$dir/assigned_to_me" ]; then META="Assigned to me"; fi
  if [ -f "$dir/created_by_me"  ]; then META="${META}${META:+ · }Created by me"; fi
  if [ -n "$META" ]; then
    STATUS_LABEL=$(cat "$dir/status"  2>/dev/null || true)
    UPDATED_LABEL=$(cat "$dir/updated" 2>/dev/null || true)
    CREATED_LABEL=$(cat "$dir/created" 2>/dev/null || true)
    if [ -n "$STATUS_LABEL"  ]; then META="${META} · ${STATUS_LABEL}"; fi
    if [ -n "$UPDATED_LABEL" ]; then META="${META} · Updated: ${UPDATED_LABEL}"; fi
    if [ -n "$CREATED_LABEL" ]; then META="${META} · Created: ${CREATED_LABEL}"; fi
    echo "_${META}_"
    echo ""
  fi

done < "$WORK/order"
