#!/bin/bash
#
# Fetch recent Jira activity for the current user.
# Usage: ./fetch-activity.sh [timeframe]
#   timeframe: 24h (default), 4h, 2h, 1d, 2d
#
# Outputs markdown sections, omitting empty ones.
# Requires: JIRA_API_TOKEN in environment, curl, jq.

set -euo pipefail

JIRA_DOMAIN="__JIRA_DOMAIN__"
JIRA_EMAIL="__JIRA_EMAIL__"
TIMEFRAME="${1:-24h}"

# Parse timeframe → JQL relative date string
if [[ "$TIMEFRAME" =~ ^([0-9]+)h$ ]]; then
  JQL_TIME="-${BASH_REMATCH[1]}h"
  LABEL="${BASH_REMATCH[1]}h"
elif [[ "$TIMEFRAME" =~ ^([0-9]+)d$ ]]; then
  JQL_TIME="-${BASH_REMATCH[1]}d"
  LABEL="${BASH_REMATCH[1]}d"
else
  JQL_TIME="-24h"; LABEL="24h"
fi

if [ -z "${JIRA_API_TOKEN:-}" ]; then
  echo "ERROR: JIRA_API_TOKEN not set" >&2
  exit 1
fi

AUTH=$(printf '%s' "${JIRA_EMAIL}:${JIRA_API_TOKEN}" | base64)

jira_get() {
  curl -s -H "Authorization: Basic ${AUTH}" -H "Accept: application/json" "$@"
}

search() {
  local jql="$1" fields="${2:-summary,status,updated}"
  jira_get -G \
    --data-urlencode "jql=${jql}" \
    --data-urlencode "maxResults=50" \
    --data-urlencode "fields=${fields}" \
    "https://${JIRA_DOMAIN}/rest/api/3/search/jql"
}

has_jql_error() {
  echo "$1" | jq -e '((.errorMessages // []) | length > 0) or ((.warningMessages // []) | length > 0)' \
    >/dev/null 2>&1
}

changelog() {
  jira_get "https://${JIRA_DOMAIN}/rest/api/3/issue/${1}/changelog?maxResults=100" 2>/dev/null \
    || echo '{"values":[]}'
}

# ── current user ─────────────────────────────────────────────────────────────
MY_ID=$(jira_get "https://${JIRA_DOMAIN}/rest/api/3/myself" | jq -r '.accountId')
if [ -z "$MY_ID" ] || [ "$MY_ID" = "null" ]; then
  echo "ERROR: could not get current user account ID — check JIRA_API_TOKEN" >&2
  exit 1
fi

echo "## Jira Activity — Last ${LABEL}"
echo ""

# Prints one "TIME | FROM → TO" line per matching entry, oldest→newest.
my_field_changes() {
  local cl="$1" field="$2"
  echo "$cl" | jq -r --arg me "$MY_ID" --arg f "$field" '
    [ .values[]
      | select(.author.accountId == $me)
      | select(any(.items[]; .field == $f))
      | { created: .created, item: (.items[] | select(.field == $f)) }
    ]
    | sort_by(.created)[]
    | "\(.created[0:16]) | \(.item.fromString // "Unassigned") → \(.item.toString // "Unassigned")"
  ' 2>/dev/null || true
}

# ── 1. Assignee changes I made ───────────────────────────────────────────────
RESP=$(search "assignee changed by currentUser() AFTER \"${JQL_TIME}\" ORDER BY updated DESC" \
              2>/dev/null || echo '{"issues":[]}')

# Fall back to 'was' approach if 'changed by' isn't supported on this instance
if has_jql_error "$RESP"; then
  RESP=$(search \
    "assignee was currentUser() AND assignee != currentUser() AND updated >= \"${JQL_TIME}\" ORDER BY updated DESC" \
    2>/dev/null || echo '{"issues":[]}')
fi

ROWS=""
while IFS= read -r key; do
  [ -z "$key" ] && continue
  SUMMARY=$(echo "$RESP" | jq -r --arg k "$key" \
    '.issues[] | select(.key==$k) | .fields.summary | .[0:55] | gsub("[|\n]";" ")')
  URL="https://${JIRA_DOMAIN}/browse/${key}"
  CL=$(changelog "$key")
  while IFS= read -r row; do
    [ -z "$row" ] && continue
    ROWS="${ROWS}| [${key}](${URL}) | ${SUMMARY} | ${row} |"$'\n'
  done < <(my_field_changes "$CL" "assignee")
done < <(echo "$RESP" | jq -r '.issues[].key' 2>/dev/null || true)

if [ -n "$ROWS" ]; then
  echo "### Assignee Changes I Made"
  echo "| Ticket | Summary | Time | Change |"
  echo "| ------ | ------- | ---- | ------ |"
  printf '%s' "$ROWS"
  echo ""
fi

# ── 2. Status changes I made (column moves) ───────────────────────────────────
RESP=$(search "status changed by currentUser() AFTER \"${JQL_TIME}\" ORDER BY updated DESC" \
              2>/dev/null || echo '{"issues":[]}')
has_jql_error "$RESP" && RESP='{"issues":[]}'  # no reliable fallback for status

ROWS=""
while IFS= read -r key; do
  [ -z "$key" ] && continue
  SUMMARY=$(echo "$RESP" | jq -r --arg k "$key" \
    '.issues[] | select(.key==$k) | .fields.summary | .[0:55] | gsub("[|\n]";" ")')
  URL="https://${JIRA_DOMAIN}/browse/${key}"
  CL=$(changelog "$key")
  while IFS= read -r row; do
    [ -z "$row" ] && continue
    ROWS="${ROWS}| [${key}](${URL}) | ${SUMMARY} | ${row} |"$'\n'
  done < <(my_field_changes "$CL" "status")
done < <(echo "$RESP" | jq -r '.issues[].key' 2>/dev/null || true)

if [ -n "$ROWS" ]; then
  echo "### Status Changes I Made"
  echo "| Ticket | Summary | Time | Change |"
  echo "| ------ | ------- | ---- | ------ |"
  printf '%s' "$ROWS"
  echo ""
fi

# ── 3. Newly assigned to me ───────────────────────────────────────────────────
RESP=$(search "assignee changed to currentUser() AFTER \"${JQL_TIME}\" ORDER BY updated DESC" \
              "summary,status,updated" 2>/dev/null || echo '{"issues":[]}')

# Fall back to currently-assigned + recently updated
if has_jql_error "$RESP"; then
  RESP=$(search "assignee = currentUser() AND updated >= \"${JQL_TIME}\" ORDER BY updated DESC" \
                "summary,status,updated" 2>/dev/null || echo '{"issues":[]}')
fi

ROWS=$(echo "$RESP" | jq -r --arg d "$JIRA_DOMAIN" '
  .issues[] |
  "| [\(.key)](https://\($d)/browse/\(.key)) | \(.fields.summary | .[0:55] | gsub("[|\n]";" ")) | \(.fields.status.name) | \(.fields.updated[0:16]) |"
' 2>/dev/null || true)

if [ -n "$ROWS" ]; then
  echo "### Assigned to Me"
  echo "| Ticket | Summary | Status | Updated |"
  echo "| ------ | ------- | ------ | ------- |"
  echo "$ROWS"
  echo ""
fi

# ── 4. Issues I created ───────────────────────────────────────────────────────
RESP=$(search "reporter = currentUser() AND created >= \"${JQL_TIME}\" ORDER BY created DESC" \
              "summary,status,created" 2>/dev/null || echo '{"issues":[]}')

ROWS=$(echo "$RESP" | jq -r --arg d "$JIRA_DOMAIN" '
  .issues[] |
  "| [\(.key)](https://\($d)/browse/\(.key)) | \(.fields.summary | .[0:55] | gsub("[|\n]";" ")) | \(.fields.status.name) | \(.fields.created[0:16]) |"
' 2>/dev/null || true)

if [ -n "$ROWS" ]; then
  echo "### Issues I Created"
  echo "| Ticket | Summary | Status | Created |"
  echo "| ------ | ------- | ------ | ------- |"
  echo "$ROWS"
  echo ""
fi
