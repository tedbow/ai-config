# Jira / Atlassian configuration
# Copy this file to .env and fill in your values.
# Then run ./build.sh to generate config files.

JIRA_CLOUD_ID=your-cloud-id-here
JIRA_DOMAIN=yoursite.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_PROJECT=PROJ
JIRA_BOARD_ID=1234

# Parent directory holding your local dev site checkouts, one folder per
# issue (used by scripts/find-dev-folder.sh)
SITES_DIR=/path/to/your/sites

# GitLab (Drupal.org code host) configuration for the triage data layer.
# GITLAB_HOST is optional and defaults to git.drupalcode.org.
# glab must already be authenticated for that host.
GITLAB_HOST=git.drupalcode.org
GITLAB_USERNAME=your-gitlab-username
# Projects whose recently-updated issues show up as "recent" rows in
# gitlab/fetch-gitlab-work.sh. Comma- or space-separated full paths.
GITLAB_WATCH_PROJECTS=project/canvas

# Your Jira display name, used to spot rows assigned to you. Optional —
# scripts/triage-fetch.sh looks it up from /rest/api/3/myself when unset.
JIRA_DISPLAY_NAME=""
